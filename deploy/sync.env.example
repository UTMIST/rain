# Configure only one staging source. The checked-in defaults create no users.
# MISTY_STAGING_URL=https://your-approved-staging-directory-endpoint
# MISTY_STAGING_ROSTER=/etc/misty-slurm-sync/people.json
SLURM_CLUSTER=rain
SLURM_ACCOUNT=misty-staging
MISTY_SYNC_INTERVAL=300

# Access Portal configuration
# MISTY_GATEWAY_URL=https://gateway-staging-dac4.up.railway.app
# MISTY_ENVIRONMENT=staging
# MISTY_GATEWAY_API_KEY=gw_...
# RAIN_WEB_HOST=0.0.0.0
# RAIN_WEB_PORT=8080
# RAIN_KEYS_DIR=/var/lib/rain/keys
